{
  "name": "penta-k-cafe-desktop",
  "version": "0.1.0",
  "description": "Penta-K Cafe desktop administration client",
  "author": "Penta-K",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 npm run electron:start\"",
    "electron:dev-test": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 ELECTRON_RENDERER_SMOKE_TEST=1 npm run electron:start\"",
    "electron:start": "npm run electron:build && node scripts/run-electron.cjs",
    "electron:smoke": "npm run electron:build && cross-env ELECTRON_SMOKE_TEST=1 node scripts/run-electron.cjs",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run electron:build",
    "electron:dist": "npm run build && electron-builder --publish never",
    "electron:dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@reduxjs/toolkit": "^2.2.7",
    "lucide-react": "^0.414.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3",
    "vite": "^8.2.1",
    "wait-on": "^7.2.0"
  }
}
